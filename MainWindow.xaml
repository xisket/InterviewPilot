<Window x:Class="InterviewCompanion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Interview Companion · Focus" Width="1240" Height="920" MinWidth="960" MinHeight="720" Background="{DynamicResource AppBackground}" FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource MainText}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource AccentButton}" CornerRadius="9" Padding="10,7" Margin="0,0,12,0"><TextBlock Text="IC" FontWeight="SemiBold" Foreground="Black"/></Border><TextBlock Text="Interview Companion" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center"/><TextBlock Text=" / Focus" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox x:Name="Pin" Content="Always on top" Margin="0,0,18,0" Checked="PinChanged" Unchecked="PinChanged"/><ToggleButton x:Name="ThemeToggle" Style="{StaticResource ThemeSwitch}" AutomationProperties.Name="Dark theme"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="18,26,18,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}" Margin="10,0,0,18"/><Button x:Name="MockButton" Style="{StaticResource NavButton}" Content="Mock practice" Click="Mock_Click"/><Button x:Name="LiveButton" Style="{StaticResource NavButton}" Content="Live assistance" Click="Live_Click"/><Button x:Name="ProfileNav" Style="{StaticResource NavButton}" Content="CV &amp; job" Click="Profile_Click"/><Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="AI settings" Click="Settings_Click"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="YOUR CONTEXT" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Text, ElementName=Role}" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock x:Name="ConnectionSummary" Text="Local practice" Style="{StaticResource Muted}" Margin="0,0,0,20"/><Button Content="Export session…" Click="Export_Click"/><Button Content="Clear session" Click="Clear_Click"/></StackPanel></Grid></Border>
   <Grid Grid.Column="1" Margin="30,26,30,20">
    <ScrollViewer x:Name="WorkspaceView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
     <TextBlock x:Name="WorkspaceEyebrow" Text="MOCK PRACTICE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="ModeLabel" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock x:Name="ModeDescription" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,22"/>
     <Border x:Name="PracticeQuestionPanel" Style="{StaticResource Panel}" Background="{DynamicResource SoftSurface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="PRACTICE QUESTION" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="Question" FontSize="18"/></StackPanel></Border>
     <Border Style="{StaticResource Panel}" Margin="0,0,0,18"><StackPanel><TextBlock x:Name="InputLabel" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto"/><CheckBox x:Name="Consent" Visibility="Collapsed" Margin="0,4,0,14"><TextBlock Text="The interviewer permits AI assistance, audio transcription, and sharing interview content." Foreground="{DynamicResource SecondaryText}" FontSize="12"/></CheckBox><WrapPanel Margin="0,8,0,4"><Button x:Name="Transcribe" Content="Transcribe interviewer" Click="Transcribe_Click" Visibility="Collapsed"/><Button x:Name="Answer" Style="{StaticResource PrimaryButton}" Content="Answer" Click="Answer_Click" Visibility="Collapsed"/><Button x:Name="Submit" Content="Review my answer" Click="Submit_Click"/><Button x:Name="Next" Content="Next question" Click="Next_Click"/><Button x:Name="Cancel" Content="Cancel request" Click="Cancel_Click" IsEnabled="False"/></WrapPanel><TextBlock x:Name="AudioStatus" Visibility="Collapsed" Foreground="{DynamicResource WarningText}" FontSize="12" Margin="0,0,0,8"/><TextBlock x:Name="InputHelp" Style="{StaticResource Muted}"/></StackPanel></Border>
     <Border Style="{StaticResource Panel}" Background="{DynamicResource SoftSurface}"><TabControl x:Name="ResultTabs" Background="Transparent" BorderThickness="0" Height="270" Padding="0"><TabItem Header="Response"><ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Output" FontSize="17" LineHeight="30"/></ScrollViewer></TabItem><TabItem Header="Prompt"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Exact last request · API key excluded" Style="{StaticResource Muted}" Margin="0,0,0,10"/><TextBox x:Name="PromptPreview" Grid.Row="1" Text="No AI request yet. Request guidance to inspect the prompt here." IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0"/></Grid></TabItem></TabControl></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="ProfileView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="800" HorizontalAlignment="Stretch" Margin="0,0,8,0"><TextBlock Text="INTERVIEW CONTEXT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Your experience. Your next role." FontSize="27" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Give your AI the context it needs for relevant, truthful answers." Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,22"/><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Target role" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Role" Text="Software engineer"/><TextBlock Text="Company / job description" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Job" AcceptsReturn="True" Height="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Your CV / experience" Style="{StaticResource FieldLabel}"/><Button x:Name="ImportCv" Content="Import CV · PDF / Word" Click="ImportCv_Click" HorizontalAlignment="Left"/><TextBox x:Name="Experience" AcceptsReturn="True" Height="200" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button x:Name="AnalyzeCv" Content="Run ATS-style check" Click="AnalyzeCv_Click" HorizontalAlignment="Left"/><TextBlock Text="Extraction and keyword checks run locally. Review the imported text before requesting AI guidance. Word format: .docx. CV, role, and job context save locally for future sessions." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Margin="0,0,8,0"><TextBlock Text="AI CONNECTION" Style="{StaticResource Eyebrow}"/><TextBlock Text="Choose how your AI runs." FontSize="27" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Connect a local model or a compatible AI service." Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,22"/><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Chat-completions endpoint (HTTPS or localhost)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Endpoint"/><TextBlock Text="Model name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Model"/><TextBlock Text="API key (saved with Windows encryption)" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="ApiKey"/><TextBlock x:Name="SettingsStatus" Text="AI settings save automatically and reload on startup." Style="{StaticResource Muted}" Margin="0,6,0,16"/><TextBlock Text="Requests send your role, CV, job description, and interview context to this endpoint. Leave the endpoint empty for built-in practice prompts and writing checks." Style="{StaticResource Muted}"/><TextBlock Text="For local Ollama" FontWeight="SemiBold" Margin="0,22,0,8"/><TextBlock Text="Endpoint: http://localhost:11434/v1/chat/completions&#10;Model: llama3.2:3b&#10;API key: leave empty" Style="{StaticResource Muted}"/></StackPanel></Border><Expander Header="1 · Set up Ollama locally" Foreground="{DynamicResource MainText}" IsExpanded="True" Margin="0,24,0,0"><StackPanel Margin="0,14,0,0">
 <TextBlock Text="Run each step in order. Commands run in PowerShell; output appears below. Installation and model downloads need internet access and disk space." Style="{StaticResource Muted}" Margin="0,0,0,14"/>
 <StackPanel x:Name="OllamaControls">
 <TextBlock Text="Step 1 · Install Ollama" FontWeight="SemiBold"/><TextBox x:Name="InstallCommand" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,8,0,8"/><Button Content="Run installation" Tag="install" Click="RunSetup_Click" HorizontalAlignment="Left"/>
 <TextBlock Text="Step 2 · Start the local server" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBox x:Name="StartCommand" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,8,0,8"/><Button Content="Start Ollama" Tag="start" Click="RunSetup_Click" HorizontalAlignment="Left"/>
 <TextBlock Text="Step 3 · Download a local model" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBlock Text="Base model name (llama3.2:3b is about 2 GB; larger models need more memory)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ContextBaseModel"/><TextBox x:Name="PullCommand" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/><Button Content="Download model" Tag="pull" Click="RunSetup_Click" HorizontalAlignment="Left"/>
 <TextBlock Text="Step 4 · Check and connect" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBox x:Name="CheckCommand" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,8,0,8"/><WrapPanel><Button Content="Check connection" Tag="check" Click="RunSetup_Click"/><Button Content="Use local Ollama in this app" Click="UseLocalOllama_Click"/></WrapPanel>
 </StackPanel>
 <Button x:Name="SetupCancel" Content="Cancel setup / sync" Click="SetupCancel_Click" IsEnabled="False" HorizontalAlignment="Left"/>
 <TextBlock x:Name="SetupStatus" Text="No setup command has been run." Style="{StaticResource Muted}" Margin="0,6,0,8"/><TextBox x:Name="SetupOutput" IsReadOnly="True" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
</StackPanel></Expander>
<Expander Header="2 · Persistent CV and document library" Foreground="{DynamicResource MainText}" IsExpanded="True" Margin="0,20,0,0"><StackPanel x:Name="LibraryControls" Margin="0,14,0,0">
 <TextBlock Text="The CV, role, and job description from CV &amp; job now save locally. Add reference documents below. Enabled reference documents are included in local AI requests; they are not treated as your personal experience." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
 <WrapPanel><Button Content="Load CV…" Click="ImportCv_Click"/><Button Content="Load documents…" Click="LoadDocuments_Click"/><Button Content="Preview enabled context" Click="PreviewContext_Click"/></WrapPanel>
 <ListBox x:Name="LibraryList" DisplayMemberPath="Name" SelectionChanged="LibrarySelectionChanged" Height="110" Background="{DynamicResource FieldSurface}" Foreground="{DynamicResource MainText}" BorderBrush="{DynamicResource Line}"/>
 <TextBlock Text="Selected document name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DocumentName"/><CheckBox x:Name="DocumentEnabled" Content="Include this document in local AI context"/><TextBox x:Name="DocumentText" AcceptsReturn="True" TextWrapping="Wrap" Height="180" VerticalScrollBarVisibility="Auto"/>
 <WrapPanel><Button Content="Save selected document" Click="SaveDocument_Click"/><Button Content="Remove selected document" Click="RemoveDocument_Click"/></WrapPanel>
 <TextBlock Text="Editing a document requires Save selected document. Original files are not changed. PDF, Word .docx, .txt, and .md are supported." Style="{StaticResource Muted}"/>
 <TextBlock Text="Assistant instructions" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ContextInstructions" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"/>
 <TextBlock Text="Maximum context characters (1,000–48,000; large context is slower)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ContextBudget"/>
 <TextBlock Text="Ollama context window in tokens (2,048–32,768; larger values need more memory)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ContextWindow"/>
 <TextBlock x:Name="LibraryStatus" Text="Library saves locally; edits are not synced to Ollama until you click Sync." Style="{StaticResource Muted}"/>
 <TextBlock Text="Your CV and extracted document text are saved in your Windows local app-data folder. The enabled context can also be saved inside a named Ollama model. Remove private content here and sync again to update that model." Foreground="{DynamicResource WarningText}" FontSize="12" Margin="0,12,0,0"/>
</StackPanel></Expander>
<Expander Header="3 · Save and inspect your personal Ollama model" Foreground="{DynamicResource MainText}" IsExpanded="True" Margin="0,20,0,0"><StackPanel x:Name="ModelControls" Margin="0,14,0,0">
 <TextBlock Text="Sync creates or updates the named local model with your selected context in its system prompt. This persists in Ollama for future sessions; it does not retrain the model. Other apps must select this model and retain its system prompt to use that context." Style="{StaticResource Muted}"/>
 <TextBlock Text="Personal model name (different from the base model)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PersonalModel"/>
 <WrapPanel><Button Content="Sync to Ollama" Click="SyncOllama_Click"/><Button Content="Inspect saved Ollama model" Click="InspectOllama_Click"/></WrapPanel>
 <TextBlock Text="Enabled app context preview (current library)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ContextPreview" IsReadOnly="True" Height="200" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
 <TextBlock Text="Actual stored Ollama model (last inspection)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OllamaModelSnapshot" IsReadOnly="True" Height="220" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
</StackPanel></Expander></StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Ready · Configure your AI in settings, or start with local practice." Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Focus workspace" Style="{StaticResource Muted}" Margin="20,0,0,0" VerticalAlignment="Center"/></Grid></Border>
 </Grid>
</Window>



